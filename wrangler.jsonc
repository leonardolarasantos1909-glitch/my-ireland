{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-ireland",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": {
    "command": "npm run build"
  },
  "workers_dev": true
}
